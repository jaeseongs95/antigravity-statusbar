{
  "$schema": "https://github.com/jaeseongs95/antigravity-native-addon-host/schemas/addon-manifest.v2.schema.json",
  "schemaVersion": 2,
  "pluginId": "antigravity-statusbar",
  "displayName": "Antigravity Statusbar",
  "version": "3.1.2",
  "trustLevel": "restricted",
  "compatibility": {
    "hostProfile": "antigravity-desktop",
    "minHostVersion": "2.0.0"
  },
  "capabilities": [
    "renderer"
  ],
  "entry": {
    "rendererScript": "runtime/statusbar-renderer.js",
    "mainHookScript": null
  },
  "uiSlots": [
    {
      "slot": "status-bar",
      "slotId": "antigravity-statusbar.root",
      "exclusive": true,
      "scope": "addon-owned-slot",
      "shadow": true
    },
    {
      "slot": "overlay",
      "slotId": "antigravity-statusbar.popover",
      "exclusive": false,
      "scope": "addon-owned-slot",
      "shadow": true
    },
    {
      "slot": "modal",
      "slotId": "antigravity-statusbar.global-limit-modal",
      "exclusive": false,
      "scope": "addon-owned-slot",
      "shadow": true
    }
  ],
  "isolation": {
    "noTranslate": true,
    "i18nSelfManaged": true,
    "respectsNoTranslate": true,
    "storageNamespace": "antigravity-statusbar"
  },
  "loadOrder": 50
}
