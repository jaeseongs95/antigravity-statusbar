{
  "$schema": "https://github.com/jaeseongs95/antigravity-addons/schemas/addon-manifest.v3.schema.json",
  "schemaVersion": 3,
  "apiVersion": 3,
  "pluginId": "antigravity-statusbar",
  "displayName": "Antigravity Statusbar",
  "version": "3.4.1",
  "trustLevel": "trusted",
  "compatibility": {
    "surfaces": [
      "desktop",
      "remote-web"
    ],
    "hostProfile": "antigravity-desktop",
    "hostProfiles": [
      "antigravity-desktop",
      "antigravity-remote-web"
    ],
    "minHostVersion": "3.3.2"
  },
  "capabilities": [
    "renderer"
  ],
  "entry": {
    "rendererScript": "runtime/statusbar-renderer.js",
    "mainHookScript": null
  },
  "permissions": {
    "ui": {
      "toasts": true,
      "dialogs": false,
      "overlays": true,
      "commands": true,
      "statusItems": false,
      "settingsPages": true,
      "canvas": true
    },
    "services": {
      "provide": [
        {
          "name": "host.statusbar",
          "allowedCallers": [
            "*"
          ]
        }
      ]
    },
    "net": {
      "localLoopback": [
        "antigravity-sidecar"
      ]
    },
    "dom": {
      "documentTransform": false,
      "anchors": [
        "status-bar"
      ]
    }
  },
  "uiSlots": [
    {
      "slot": "status-bar",
      "slotId": "antigravity-statusbar.root",
      "anchor": "status-bar",
      "exclusive": true,
      "scope": "addon-owned-slot",
      "shadow": true
    }
  ],
  "isolation": {
    "noTranslate": true,
    "i18nSelfManaged": true,
    "respectsNoTranslate": true,
    "storageNamespace": "antigravity-statusbar"
  },
  "settingsBridge": {
    "fileName": "antigravity-statusbar-runtime.json",
    "maxBytes": 16384
  },
  "loadOrder": 50
}
